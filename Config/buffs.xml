<IndonesianCulinary>
    <append xpath="/buffs">
        <buff name="buffWedangUwuh" name_key="drinkJarWedangUwuh"
            description_key="drinkJarWedangUwuhDesc" icon="ui_game_symbol_coffee">
            <stack_type value="replace" />
            <duration value="0" />
            <display_value value=".buffWedangUwuhDisplay" />
            <display_value_format value="time" />

            <effect_group>
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar="$buffWedangUwuhDuration" operation="subtract" value="@$MetabolismDuration" />
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar=".buffWedangUwuhDisplay" operation="set" value="@$buffWedangUwuhDuration" />
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar=".buffWedangUwuhDisplay" operation="divide" value="@$MetabolismDuration" />
            </effect_group>

            <effect_group>
                <triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff"
                    buff="buffWedangUwuh">
                    <requirement name="CVarCompare" cvar="$buffWedangUwuhDuration" operation="LTE"
                        value="0" />
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff"
                    buff="buffWedangUwuh">
                    <requirement name="HasBuff" buff="god" />
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar"
                    cvar=".buffWedangUwuhDisplay,$buffWedangUwuhDuration" />
            </effect_group>

            <effect_group>
                <passive_effect name="GeneralDamageResist" operation="base_add" value="0.05" />
            </effect_group>
        </buff>
        <buff name="buffTinutuan" name_key="foodTinutuan"
            description_key="foodTinutuanDesc" icon="ui_game_symbol_coffee">
            <stack_type value="replace" />
            <duration value="0" />
            <display_value value=".buffTinutuanDisplay" />
            <display_value_format value="time" />

            <effect_group>
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar="$buffTinutuanDuration" operation="subtract" value="@$MetabolismDuration" />
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar=".buffTinutuanDisplay" operation="set" value="@$buffTinutuanDuration" />
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar=".buffTinutuanDisplay" operation="divide" value="@$MetabolismDuration" />
            </effect_group>

            <effect_group>
                <triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff"
                    buff="buffTinutuan">
                    <requirement name="CVarCompare" cvar="$buffTinutuanDuration" operation="LTE"
                        value="0" />
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff"
                    buff="buffTinutuan">
                    <requirement name="HasBuff" buff="god" />
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar"
                    cvar=".buffTinutuanDisplay,$buffTinutuanDuration" />
            </effect_group>

            <effect_group>
                <requirement name="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE"
                    value="40" />
                <passive_effect name="HarvestCount" operation="base_add" value="1"
                    tags="farmerBonusHarvest" />
            </effect_group>
        </buff>
        <buff name="buffKopiJoss" name_key="drinkJarKopiJoss"
            description_key="drinkJarKopiJossDesc" icon="ui_game_symbol_coffee">
            <stack_type value="replace" />
            <duration value="0" />
            <display_value value=".buffKopiJossDisplay" />
            <display_value_format value="time" />

            <effect_group>
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar="$buffKopiJossDuration" operation="subtract" value="@$MetabolismDuration" />
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar=".buffKopiJossDisplay" operation="set" value="@$buffKopiJossDuration" />
                <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar"
                    cvar=".buffKopiJossDisplay" operation="divide" value="@$MetabolismDuration" />
            </effect_group>

            <effect_group>
                <triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff"
                    buff="buffKopiJoss">
                    <requirement name="CVarCompare" cvar="$buffKopiJossDuration" operation="LTE"
                        value="0" />
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff"
                    buff="buffKopiJoss">
                    <requirement name="HasBuff" buff="god" />
                </triggered_effect>
                <triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar"
                    cvar=".buffKopiJossDisplay,$buffKopiJossDuration" />
            </effect_group>
            <effect_group>
                <passive_effect name="StaminaChangeOT" operation="perc_add" value="0.18" />
                <passive_effect name="HypothermalResist" operation="base_add" value="10" />
            </effect_group>
        </buff>
    </append>
</IndonesianCulinary>