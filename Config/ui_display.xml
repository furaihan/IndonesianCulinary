<IndonesianCulinary>
    <append xpath="/ui_display_info/item_display">
        <item_display_info display_type="foodKolak" display_group="groupConsumables">
            <display_entry name="$foodAmountAdd" title_key="statFoodAmount" />
            <display_entry name="foodHealthAmount" title_key="statHealthAmount" />
            <display_entry name="$waterAmountAdd" title_key="statWaterAmount" />
            <display_entry name="dCureDysentery" title_key="statCureDysentery"
                display_type="Percent" />
        </item_display_info>
        <item_display_info display_type="waterWedangUwuh" display_group="groupConsumables">
            <display_entry name="$waterAmountAdd" title_key="statWaterAmount" />
            <display_entry name="dCureDysentery" title_key="statCureDysentery"
                display_type="Percent" />
            <display_entry name="dHealthLoss" title_key="statHealthLoss" display_type="Percent"
                display_leading_plus="true" />
            <display_entry name="dDuration" title_key="statDuration" display_type="Time" />
        </item_display_info>
        <item_display_info display_type="foodTinutuan" display_group="groupConsumables">
            <display_entry name="$foodAmountAdd" title_key="statFoodAmount"/>
			<display_entry name="foodHealthAmount" title_key="statHealthAmount"/>
			<display_entry name="$waterAmountAdd" title_key="statWaterAmount"/>
			<display_entry name=".foodStaminaBonusAdd" title_key="statFoodStaminaBonus"/>
            <display_entry name="dHarvestCount" title_key="statCropHarvestCount" display_type="Percent"/>
            <display_entry name="dDuration" title_key="statDuration" display_type="Time" />
        </item_display_info>
        <item_display_info display_type="waterKopiJoss" display_group="groupConsumables">
			<display_entry name="$waterAmountAdd" title_key="statWaterAmount"/>
			<display_entry name="dStaminaRegen" title_key="statStaminaRegen" display_type="Percent"/>
			<display_entry name="dHypothermalResist" title_key="statHypothermalResist"/>
            <display_entry name="dCureDysentery" title_key="statCureDysentery"
                display_type="Percent" />
			<display_entry name="dDuration" title_key="statDuration" display_type="Time"/>
		</item_display_info>
        <item_display_info display_type="foodPerkedel" display_group="groupConsumables">
            <display_entry name="$foodAmountAdd" title_key="statFoodAmount" />
            <display_entry name="foodHealthAmount" title_key="statHealthAmount" />
            <display_entry name="$waterAmountAdd" title_key="statWaterAmount"/>
            <display_entry name="dRunSpeed" title_key="statRunSpeed" display_type="Percent" display_leading_plus="true"/>
            <display_entry name="dDuration" title_key="statDuration" display_type="Time"/>
        </item_display_info>
        <item_display_info display_type="foodSambal" display_group="groupConsumables">
            <display_entry name="$foodAmountAdd" title_key="statFoodAmount" />
            <display_entry name="foodHealthAmount" title_key="statHealthAmount" />
            <display_entry name="$waterAmountAdd" title_key="statWaterAmount"/>
            <display_entry name="dRunSpeed" title_key="statRunSpeed" display_type="Percent" display_leading_plus="true"/>
            <display_entry name="dDuration" title_key="statDuration" display_type="Time"/>
        </item_display_info>
        <item_display_info display_type="foodRawon" display_group="groupConsumables">
            <display_entry name="dEntityDamage" title_key="statEntityDamageMelee" display_type="Percent" display_leading_plus="true"/>
            <display_entry name="$foodAmountAdd" title_key="statFoodAmount" />
            <display_entry name="foodHealthAmount" title_key="statHealthAmount" />
            <display_entry name="$waterAmountAdd" title_key="statWaterAmount"/>
            <display_entry name="dStaminaRegen" title_key="statStaminaRegen" display_type="Percent"/>
            <display_entry name="dDuration" title_key="statDuration" display_type="Time"/>
        </item_display_info>
         <item_display_info display_type="foodSotoBetawi" display_group="groupConsumables">
            <display_entry name="dLootStageFlat" title_key="statLootStage" display_leading_plus="true"/>
			<display_entry name="dLootStagePerc" title_key="statLootStage" display_type="Percent" display_leading_plus="true"/>
            <display_entry name="dStunResist" title_key="statStunResist" display_type="Percent" />
			<display_entry name="$foodAmountAdd" title_key="statFoodAmount" />
            <display_entry name="foodHealthAmount" title_key="statHealthAmount" />
            <display_entry name="$waterAmountAdd" title_key="statWaterAmount"/>
            <display_entry name="dDuration" title_key="statDuration" display_type="Time"/>
        </item_display_info>
    </append>
</IndonesianCulinary>