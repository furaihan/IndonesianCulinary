<IndonesianCulinary>
    <insertAfter xpath="//lootgroup[@name='groupScrapCommon']">
        <lootgroup name="groupIndonesianFoodT1">
            <item name="foodSateJamur" />
            <item name="drinkJarWedangUwuh" />
            <item name="foodSateAyam" loot_prob_template="low" />
            <item name="foodBakwanJagung" />
            <item name="foodKolak" loot_prob_template="low" />
            <item name="drinkJarKopiJoss" loot_prob_template="medLow" />
            <item name="foodPerkedel" loot_prob_template="medLow" />
            <item name="foodSambalBawang" />
            <item name="foodSambalMatah" />
        </lootgroup>
        <lootgroup name="groupIndonesianFoodT2">
            <item name="foodTinutuan" />
            <item name="foodSotoBetawi" />
            <item name="foodRawon" loot_prob_template="low" />
        </lootgroup>
        <lootgroup name="groupIndonesianCannedFood">
            <!-- TBA -->
        </lootgroup>
        <lootgroup name="groupIndonesianFood">
            <item name="foodSateJamur" />
            <item name="foodSateAyam" />
            <item name="foodKolak" />
            <item name="foodTinutuan" />
            <item name="foodSotoBetawi" />
            <item name="foodRawon" />
            <item name="foodBakwanJagung" />
            <item name="foodPerkedel" />
            <item name="foodSambalBawang" />
            <item name="foodSambalMatah" />
        </lootgroup>
        <lootgroup name="groupIndonesianDrink">
            <item name="drinkJarWedangUwuh" />
            <item name="drinkJarKopiJoss" />
        </lootgroup>
        <lootgroup name="groupIndonesianFoodAll">
            <item group="groupIndonesianFood" />
            <item group="groupIndonesianDrink" />
        </lootgroup>
    </insertAfter>
    <append xpath="/lootcontainers/lootgroup[@name='groupGrills']">
        <item name="foodSateJamur" count="1,2" loot_prob_template="veryLow" />
        <item name="foodSateAyam" count="1,2" loot_prob_template="veryLow" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='groupDrinksUncommon']">
        <item name="drinkJarWedangUwuh" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='airdropdrink']">
        <item name="drinkJarWedangUwuh" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='cannedFood']">
        <item name="foodSambalBawang" count="2,4" />
        <item name="foodSambalMatah" count="1,3" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='airdropfood']">
        <item name="foodKolak" />
        <item name="foodSateAyam" />
        <item name="foodSateJamur" />
        <item name="foodTinutuan" />
        <item name="foodSotoBetawi" />
        <item name="foodRawon" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='twitch_drink']">
        <item name="drinkJarWedangUwuh" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='groupQuestFood']">
        <item name="foodKolak" count="2,5" loot_prob_template="QuestT1Prob" />
        <item name="foodTinutuan" count="2,5" loot_prob_template="QuestT2Prob" />
        <item name="foodSotoBetawi" count="2,5" loot_prob_template="QuestT2Prob" />
        <item name="foodRawon" count="2,5" loot_prob_template="QuestT2Prob" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='twitch_foodT1']">
        <item name="foodKolak" count="2,4" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='groupFoodRare']">
        <item name="foodTinutuan" count="2,4" />
        <item name="foodSotoBetawi" count="2,4" />
        <item name="foodRawon" count="2,4" />
    </append>
    <append xpath="/lootcontainers/lootgroup[@name='groupFoodPileCommon']">
        <item name="foodBakwanJagung" count="2,4" />
    </append>

    <!-- Skill magazine loot -->
    <append
        xpath="//lootgroup[item[contains(@name, 'foodSkillMagazine') and (@loot_prob_template='veryLow')]]">
        <item name="indonesianFoodSkillMagazine" count="1" loot_prob_template="veryLow"
            force_prob="true" />
    </append>
    <append
        xpath="//lootgroup[item[contains(@name, 'foodSkillMagazine') and (@loot_prob_template='low')]]">
        <item name="indonesianFoodSkillMagazine" count="1" loot_prob_template="low"
            force_prob="true" />
    </append>
    <append
        xpath="//lootgroup[item[contains(@name, 'foodSkillMagazine') and (@loot_prob_template='medLow')]]">
        <item name="indonesianFoodSkillMagazine" count="1" loot_prob_template="medLow"
            force_prob="true" />
    </append>

    <append
        xpath="//lootgroup[item[contains(@name, 'foodSkillMagazine') and (@loot_prob_template='med')]]">
        <item name="indonesianFoodSkillMagazine" count="1" loot_prob_template="med"
            force_prob="true" />
    </append>
    <append
        xpath="//lootgroup[item[contains(@name, 'foodSkillMagazine') and (@loot_prob_template='high')]]">
        <item name="indonesianFoodSkillMagazine" count="1" loot_prob_template="high"
            force_prob="true" />
    </append>
    <append
        xpath="//lootgroup[item[contains(@name, 'foodSkillMagazine') and not(@loot_prob_template)]]">
        <item name="indonesianFoodSkillMagazine" count="1,2" />
    </append>

     <conditional>
        <if cond="mod_loaded('EFT_Overhaul')">
            <append xpath="/lootcontainers/lootgroup[@name='groupEftKitchenFoodAll']">
                <item group="groupIndonesianFoodAll" count="1,2" loot_prob_template="med" />
            </append>
            <append xpath="/lootcontainers/lootgroup[@name='groupEftKitchenFreshFood']">
                 <item group="groupIndonesianFood" />
                 <item name="foodSotoBetawi" />
            </append>
            <append xpath="/lootcontainers/lootgroup[@name='groupEftKitchenCoffee']">
                <item name="drinkJarKopiJoss" count="1,2" />
            </append>
            <append xpath="/lootcontainers/lootgroup[@name='groupEftKitchenDrink']">
                <item name="drinkJarWedangUwuh" count="1,2" loot_prob_template="low" />
            </append>
        </if>
    </conditional>

</IndonesianCulinary>