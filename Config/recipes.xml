<IndonesianCulinary>
	<append xpath="/recipes">
		<recipe name="foodSateJamur" count="1" craft_area="campfire" craft_tool="toolCookingGrill"
			tags="perkMasterChef,learnable">
			<ingredient name="foodCropMushrooms" count="3" />
			<ingredient name="foodCornMeal" count="1" />
			<ingredient name="resourceWood" count="8" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-2,-3" tags="resourceWood" />
			</effect_group>
		</recipe>
		<recipe name="foodSateAyam" count="1" craft_area="campfire" craft_tool="toolCookingGrill"
			tags="perkMasterChef,learnable">
			<ingredient name="foodRawMeat" count="5" />
			<ingredient name="resourceWood" count="8" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-2,-3" tags="resourceWood" />
			</effect_group>
		</recipe>
		<recipe name="foodKolak" count="1" craft_area="campfire" craft_tool="toolCookingPot"
			tags="perkMasterChef,learnable">
			<ingredient name="foodCropYuccaFruit" count="3" />
			<ingredient name="foodCropPumpkin" count="2" />
			<ingredient name="drinkJarBoiledWater" count="2" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="2, 3" operation="base_add"
					value="-1, -1" tags="foodCropYuccaFruit" />
				<passive_effect name="CraftingIngredientCount" level="3" operation="base_add"
					value="-1" tags="foodCropPumpkin" />
			</effect_group>
		</recipe>
		<recipe name="drinkJarWedangUwuh" count="1" craft_area="campfire"
			craft_tool="toolCookingPot" tags="perkMasterChef,learnable">
			<ingredient name="resourceCropChrysanthemumPlant" count="3" />
			<ingredient name="resourceCropGoldenrodPlant" count="1" />
			<ingredient name="resourceYuccaFibers" count="3" />
			<ingredient name="drinkJarBoiledWater" count="1" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="2, 3" operation="base_add"
					value="-1, -2" tags="resourceCropChrysanthemumPlant" />
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-1,-1" tags="resourceYuccaFibers" />
			</effect_group>
		</recipe>
		<!-- Tinutuan -->
		<recipe name="foodTinutuan" count="1" craft_area="campfire" craft_tool="toolCookingPot"
			tags="perkMasterChef,learnable">
			<ingredient name="foodCropCorn" count="3" />
			<ingredient name="foodCropPumpkin" count="2" />
			<ingredient name="foodCropYuccaFruit" count="2" />
			<ingredient name="foodCropPotato" count="1" />
			<ingredient name="drinkJarBoiledWater" count="1" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-1,-1" tags="foodCropCorn" />
				<passive_effect name="CraftingIngredientCount" level="2,3" operation="base_add"
					value="-1,-1" tags="foodCropYuccaFruit" />
				<passive_effect name="CraftingIngredientCount" level="3" operation="base_add"
					value="-1" tags="foodCropPumpkin" />
			</effect_group>
		</recipe>
		<!-- Bakwan Jagung -->
		<recipe name="foodBakwanJagung" count="1" craft_area="campfire" craft_tool="toolCookingPot"
			tags="perkMasterChef,learnable">
			<ingredient name="foodCropCorn" count="2" />
			<ingredient name="foodCornMeal" count="2" />
			<ingredient name="drinkJarBoiledWater" count="1" />
			<ingredient name="resourceAnimalFat" count="1" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-1,-1" tags="foodCropCorn" />
				<passive_effect name="CraftingIngredientCount" level="2,3" operation="base_add"
					value="-1,-1" tags="foodCornMeal" />
			</effect_group>
		</recipe>
		<!-- Kopi Joss -->
		<recipe name="drinkJarKopiJoss" count="1" craft_area="campfire" craft_tool="toolCookingPot"
			tags="perkMasterChef,learnable">
			<ingredient name="resourceCropCoffeeBeans" count="2" />
			<ingredient name="resourceCoal" count="1" />
			<ingredient name="drinkJarBoiledWater" count="1" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-1,-1" tags="resourceCropCoffeeBeans" />
			</effect_group>
		</recipe>
		<recipe name="foodPerkedel" count="1" craft_area="campfire" craft_tool="toolCookingPot"
			tags="perkMasterChef,learnable">
			<ingredient name="foodCropPotato" count="2" />
			<ingredient name="foodCornMeal" count="2" />
			<ingredient name="drinkJarBoiledWater" count="1" />
			<ingredient name="resourceAnimalFat" count="1" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="2,3" operation="base_add"
					value="-1,-1" tags="foodCropPotato" />
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-1,-1" tags="foodCornMeal" />
			</effect_group>

		</recipe>
		<recipe name="foodRawon" count="1" craft_area="campfire" craft_tool="toolCookingPot"
			tags="perkMasterChef,learnable">
			<ingredient name="foodBoiledMeat" count="4" />
			<ingredient name="resourceCropGoldenrodPlant" count="4" />
			<ingredient name="foodEggBoiled" count="1" />
			<ingredient name="foodCropPotato" count="1" />
			<ingredient name="drinkJarBoiledWater" count="2" />
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="2,3" operation="base_add"
					value="-1,-1" tags="resourceCropGoldenrodPlant" />
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-1,-2" tags="foodRawMeat" />
			</effect_group>
		</recipe>
		<recipe name="foodSotoBetawi" count="1" craft_area="campfire" craft_tool="toolCookingPot"
			tags="perkMasterChef,learnable">
			<ingredient name="foodBaconAndEggs" count="1" />
			<ingredient name="foodCropPotato" count="2" />
			<ingredient name="resourceAnimalFat" count="4" />
			<ingredient name="drinkJarBoiledWater" count="2" />
			<ingredient name="resourceCropGoldenrodPlant" count="4"/>
			<effect_group>
				<passive_effect name="CraftingIngredientCount" level="3" operation="base_add"
					value="-1" tags="foodCropPotato" />
				<passive_effect name="CraftingIngredientCount" level="2,3" operation="base_add"
					value="-1,-2" tags="resourceAnimalFat" />
				<passive_effect name="CraftingIngredientCount" level="1,2,3" operation="base_add"
					value="-1,-1,-2" tags="resourceCropGoldenrodPlant" />
			</effect_group>
		</recipe>
	</append>

	<conditional>
		<if cond="mod_loaded('EFT_Overhaul')">
			<removeattribute
				xpath="//recipe[@name='foodSateJamur' 
				or @name='foodSateAyam' 
				or @name='foodKolak' 
				or @name='drinkJarWedangUwuh' 
				or @name='foodTinutuan' 
				or @name='foodBakwanJagung' 
				or @name='drinkJarKopiJoss' 
				or @name='foodPerkedel']/@tags" />
		</if>
	</conditional>
</IndonesianCulinary>